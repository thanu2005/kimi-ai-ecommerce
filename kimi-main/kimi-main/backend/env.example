# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5454
POSTGRES_DB=ecommerce_ops

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=support_ticket_embeddings

# ── LLM / Observability ───────────────────────────────────────────────────────
DIAL_API_KEY=sk-...
DIAL_ENDPOINT=https://ai-proxy.lab.epam.com
DIAL_API_VERSION=2025-04-01-preview
DIAL_CHAT_DEPLOYMENT=claude-sonnet-4-5@20250929
DIAL_EMBEDDING_DEPLOYMENT=text-embedding-3-small-1
LANGSMITH_API_KEY=ls__...
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ecommerce-ops-brain

# ── MCP Server ───────────────────────────────────────────────────────────────
# Start the MCP server manually before running FastAPI (from project root):
#   fastmcp run mcp_server/server.py:mcp --transport sse --port 8001
# Then set this URL so all agents share the one server instead of spawning
# their own stdio subprocess per run. Leave blank to use stdio (slower).
MCP_SSE_URL=http://localhost:8001/sse

# ── FastAPI ───────────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
